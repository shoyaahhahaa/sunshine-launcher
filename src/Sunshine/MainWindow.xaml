<Window x:Class="Sunshine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sunshine"
        Width="400" Height="580"
        MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/app_icon.png"
        FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable Display, Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="12"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/app_icon.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Sunshine" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"/>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,4,20,20" shell:WindowChrome.IsHitTestVisibleInChrome="True">

                <TextBlock Text="VERSION" Style="{StaticResource LabelText}" Margin="2,10,0,4"/>
                <ComboBox x:Name="VersionComboBox" Height="36"/>

                <TextBlock x:Name="AccountLabel" Text="USERNAME (OFFLINE)" Style="{StaticResource LabelText}" Margin="2,16,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UsernameTextBox" Grid.Column="0" Height="48" FontSize="16" MaxLength="16"/>
                    <Button x:Name="AccountsDropdownButton" Grid.Column="2" Width="44" Height="48"
                            Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource TitleBarButton}" Click="AccountsDropdownButton_Click"
                            ToolTip="Saved accounts"/>
                    <Button x:Name="AddAccountButton" Grid.Column="4" Width="44" Height="48"
                            Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Style="{StaticResource TitleBarButton}" Click="AddAccountButton_Click"
                            ToolTip="Save this offline name"/>
                    <Button x:Name="MicrosoftSignInButton" Grid.Column="6" Width="44" Height="48"
                            Style="{StaticResource TitleBarButton}" Click="MicrosoftSignInButton_Click"
                            ToolTip="Sign in with Microsoft">
                        <Grid Width="16" Height="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="1.5"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="1.5"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#F25022"/>
                            <Rectangle Grid.Row="0" Grid.Column="2" Fill="#7FBA00"/>
                            <Rectangle Grid.Row="2" Grid.Column="0" Fill="#00A4EF"/>
                            <Rectangle Grid.Row="2" Grid.Column="2" Fill="#FFB900"/>
                        </Grid>
                    </Button>
                    <Popup x:Name="AccountsPopup" PlacementTarget="{Binding ElementName=UsernameTextBox}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="#E618161F" BorderBrush="{StaticResource FieldBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="260">
                            <ListBox x:Name="AccountsListBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" MaxHeight="220" Margin="4"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="AccountsListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                    Width="24" Height="24" Style="{StaticResource TitleBarButton}"
                                                    Visibility="{Binding RemoveVisibility}" Tag="{Binding}"
                                                    Click="RemoveAccountButton_Click" ToolTip="Remove"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <Grid Margin="2,20,0,4">
                    <TextBlock Text="MAX MEMORY" Style="{StaticResource LabelText}" Margin="0"/>
                    <TextBlock x:Name="MaxRamValueText" Text="4 GB" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="MaxRamSlider" Minimum="1" Maximum="16" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True"
                        TickFrequency="1" ValueChanged="MaxRamSlider_ValueChanged"/>

                <CheckBox x:Name="PerformanceFlagsCheckBox" Content="Optimized JVM flags (recommended)" Margin="2,20,0,0"/>
                <CheckBox x:Name="ExitAfterLaunchCheckBox" Content="Close launcher after game starts" Margin="2,12,0,0"/>

                <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" Margin="2,18,0,0" TextWrapping="Wrap"/>

                <Button x:Name="LaunchButton" Content="LAUNCH" Style="{StaticResource AccentButton}"
                        Margin="0,16,0,0" Click="LaunchButton_Click"/>
            </StackPanel>

            <Button x:Name="OpenFolderButton" Grid.Row="1" Width="40" Height="40"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                    Style="{StaticResource TitleBarButton}" Click="OpenFolderButton_Click"
                    ToolTip="Open .minecraft folder"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M1,3.5 L6.5,3.5 L8,5.5 L17,5.5 L17,15 L1,15 Z"
                      Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" Width="16" Height="14"/>
            </Button>
        </Grid>
    </Border>
</Window>
